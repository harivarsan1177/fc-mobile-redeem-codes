rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Codes collection rules
    match /codes/{codeId} {
      // Public users can only read non-deleted codes
      // Authenticated admins can read all codes including soft-deleted ones
      allow read: if resource.data.deleted == false || request.auth != null;

      // Only authenticated administrators can create or update codes
      allow create: if request.auth != null
                    && request.resource.data.code is string
                    && request.resource.data.reward is string
                    && request.resource.data.status in ['ACTIVE', 'EXPIRING_SOON', 'EXPIRED', 'LIMIT_REACHED', 'DISABLED', 'PENDING_VERIFICATION']
                    && request.resource.data.deleted is bool;

      allow update: if request.auth != null;

      // Permanent deletions are disabled; enforce soft deletion (deleted: true)
      allow delete: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
